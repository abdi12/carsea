# Copy to .env for local development. Never commit real secrets.
POSTGRES_USER=carsea
POSTGRES_PASSWORD=change-me
POSTGRES_DB=carsea

# Used by the app and drizzle-kit when running outside Docker Compose.
DATABASE_URL=postgres://carsea:change-me@localhost:5432/carsea

# Public origin, used at build time for canonical and alternate links.
SITE_URL=http://localhost:3000

# Optional host ports for Docker Compose (defaults: 5432 and 3000).
# DB_PORT=5432
# APP_PORT=3000
